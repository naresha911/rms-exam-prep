# Supabase Configuration
# Get these from your Supabase project dashboard: https://app.supabase.com/project/_/settings/api
#
# As of late 2024, Supabase deprecated "anon" and "service_role" keys.
# Use "publishable" key (sb_publishable_*) for client-side auth.
# Use "secret" key (sb_secret_*) for server-side admin operations only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# PostHog Analytics
# Get your API key from: https://posthog.com/settings/project
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
